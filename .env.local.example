NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Domain des Deployments (Reset-Links, Einladungen, Stripe-Rückkehr)
NEXT_PUBLIC_SITE_URL=https://fuhrpark.example.com

# Push (VAPID) — öffentlicher Schlüssel
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Nur für den Stripe-Webhook (niemals im Browser verwenden)
SUPABASE_SERVICE_ROLE_KEY=

# Belegerkennung per Foto (Claude). Ohne Schlüssel bleibt der Knopf
# "Beleg auslesen" ausgeblendet, alles andere funktioniert unverändert.
ANTHROPIC_API_KEY=
